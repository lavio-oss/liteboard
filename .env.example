# Root Docker Compose environment. Replace the key and password placeholders;
# setup instructions are in docs/README.md.
APP_KEY=base64:generate-a-local-key-with-php-artisan-key-generate
POSTGRES_DB=liteboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Internal ports used by services inside Docker Compose.
MQTT_PG_PORT=5432
MQTT_REDIS_PORT=6379

# MQTT authentication used by telemetry-service and the broker healthcheck.
MQTT_PG_HOST=postgres
MQTT_REDIS_HOST=redis
MQTT_INTERNAL_USERNAME=telemetry-service
MQTT_INTERNAL_PASSWORD=change-me-telemetry-service-password
MQTT_HEALTHCHECK_USERNAME=healthcheck
MQTT_HEALTHCHECK_PASSWORD=change-me-healthcheck-password
MQTT_BRIDGE_USERNAME=plaintext-bridge
MQTT_BRIDGE_PASSWORD=change-me-plaintext-bridge-password

# TLS hostname must match the certificate SAN.
MQTT_TLS_HOSTNAME=mqtt.local
MQTT_TLS_CERT_FILE=./infrastructure/mosquitto/certs/broker/server.crt
MQTT_TLS_KEY_FILE=./infrastructure/mosquitto/certs/broker/server.key
MQTT_TLS_CA_SOURCE=./infrastructure/mosquitto/certs/ca.crt

SIMULATOR_PROJECT_ID=
SIMULATOR_DEVICE_ID=
SIMULATOR_DEVICE_ACCESS_TOKEN=
SIMULATOR_CONNECTION_MODE=manual
SIMULATOR_PROVISION_KEY=
SIMULATOR_PROVISION_SECRET=
SIMULATOR_DEVICE_NAME=LiteBoard simulator
SIMULATOR_DEVICE_CODE=simulator-001
SIMULATOR_FIRMWARE_VERSION=simulator
DEVICE_PROVISIONING_URL=https://provisioning.example.invalid/api/device-provisioning/bootstrap
DEVICE_PROVISIONING_CA_FILE=./infrastructure/provisioning/ca.crt
DEVICE_PROVISIONING_MQTT_HOST=mqtt.local
# Must match the ports published by docker-compose.
DEVICE_PROVISIONING_MQTT_TLS_PORT=8883
DEVICE_PROVISIONING_MQTT_PLAINTEXT_PORT=1883
DEVICE_PROVISIONING_IP_RATE_LIMIT=30
DEVICE_PROVISIONING_PROFILE_RATE_LIMIT=60
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
BACKEND_PORT=8800
TELEMETRY_PORT=8100
FRONTEND_PORT=3000
