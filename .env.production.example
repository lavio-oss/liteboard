# Production env for docker-compose.prod.yml. Copy to .env.production and fill every change-me.
APP_DOMAIN=app.example.com
APP_KEY=base64:generate-with-php-artisan-key-generate-show

POSTGRES_DB=liteboard
POSTGRES_USER=liteboard
POSTGRES_PASSWORD=change-me
MQTT_PG_PORT=5432
MQTT_REDIS_PORT=6379

# Optional dedicated role with synchronous_commit=off (docs/setup/production.md). Leave empty to reuse POSTGRES_USER.
TELEMETRY_DB_USERNAME=
TELEMETRY_DB_PASSWORD=

TELEMETRY_WS_SECRET=change-me-random-64-chars
TELEMETRY_INTERNAL_SECRET=change-me-random-64-chars

MQTT_INTERNAL_USERNAME=telemetry-service
MQTT_INTERNAL_PASSWORD=change-me
MQTT_HEALTHCHECK_USERNAME=healthcheck
MQTT_HEALTHCHECK_PASSWORD=change-me
MQTT_BRIDGE_USERNAME=plaintext-bridge
MQTT_BRIDGE_PASSWORD=change-me

# Devices connect to this name; it must be in the broker certificate SAN and resolve to the VPS.
MQTT_TLS_HOSTNAME=mqtt.example.com
MQTT_TLS_CERT_FILE=./infrastructure/mosquitto/certs/broker/server.crt
MQTT_TLS_KEY_FILE=./infrastructure/mosquitto/certs/broker/server.key
MQTT_TLS_CA_SOURCE=./infrastructure/mosquitto/certs/ca.crt

DEVICE_PROVISIONING_MQTT_HOST=mqtt.example.com
DEVICE_PROVISIONING_MQTT_TLS_PORT=8883
DEVICE_PROVISIONING_MQTT_PLAINTEXT_PORT=1883
DEVICE_PROVISIONING_IP_RATE_LIMIT=30
DEVICE_PROVISIONING_PROFILE_RATE_LIMIT=60
DEVICE_PROVISIONING_URL=https://app.example.com/api/device-provisioning/bootstrap
