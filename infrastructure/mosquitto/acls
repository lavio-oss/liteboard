user telemetry-service
topic readwrite liteboard/#
topic subscribe liteboard/#
# Broker drop counter and stored-message count, exported on telemetry-service /metrics.
topic read $SYS/broker/publish/messages/dropped
topic read $SYS/broker/store/messages/count

user healthcheck
topic write healthcheck

# Bridge from mosquitto-plain: device traffic in, commands out. Nothing else.
user plaintext-bridge
topic write liteboard/+/devices/+/telemetry
topic write liteboard/+/devices/+/heartbeat
topic write liteboard/+/devices/+/commands/ack
topic write liteboard/+/devices/+/gateway/+
topic read liteboard/+/devices/+/commands
